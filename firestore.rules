rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A worker's data: only the worker, or a linked supervisor whose access is active (read-only).
    match /workers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (exists(/databases/$(database)/documents/links/$(uid + "_" + request.auth.uid)) &&
         get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.active == true));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Share codes: anyone signed in can look up one code, nobody can list them.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(["uid"]);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Links between a supervisor and a worker.
    match /links/{linkId} {
      allow read: if request.auth != null &&
        (resource.data.supUid == request.auth.uid || resource.data.workerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.supUid == request.auth.uid
                    && linkId == request.resource.data.workerUid + "_" + request.auth.uid
                    && request.resource.data.keys().hasOnly(["workerUid", "supUid", "createdAt"]);
      allow delete: if request.auth != null &&
        (resource.data.supUid == request.auth.uid || resource.data.workerUid == request.auth.uid);
    }

    // Helpline contacts: any signed-in user can read; nobody can write from the app (edit in the console).
    match /config/{id} {
      allow read: if request.auth != null;
    }

    // Premium (themes): a person can only read their own record. Only you (in the console) can create or change it.
    match /premium/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Paid supervisors: a person can only read their own record. Only you (in the console) can create or change it.
    match /supervisors/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
